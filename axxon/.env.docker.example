# Container-only overrides. Copy to .env.docker for docker compose development.
AXXON_ENV_MODE=docker

# Services resolve each other by Compose service name.
PG_HOST=db
PG_PORT=5432
PG_HOST_FALLBACK=host.docker.internal
REDIS_URL=redis://redis:6379

# Ollama remains on the host and is reached through Docker's host gateway.
AI_LOCAL_BASE_URL=http://host.docker.internal:11434
