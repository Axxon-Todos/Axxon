# Host-oriented local defaults and development secrets. Copy to .env.local.
AXXON_DEPLOY_STAGE=development
AXXON_ENV_MODE=host

# Used to sign local session and GitHub integration state cookies.
JWT_SECRET=replace-with-a-local-random-secret

# Browser and websocket origins.
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_HOSTNAME=http://localhost:3000
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
NEXT_PUBLIC_WS_URL=http://localhost:4000

# These values match the ports exposed by docker-compose.yml on the host.
PG_HOST=127.0.0.1
PG_PORT=55432
PG_USER=postgres
PG_PASS=postgres
PG_DB=axxon
REDIS_URL=redis://127.0.0.1:6379

# Ollama runs directly on the host during Docker development.
AI_LOCAL_BASE_URL=http://127.0.0.1:11434
AI_LOCAL_MODEL=qwen2.5-coder:14b

# Optional: fill these in to enable Google OAuth locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional: fill these in to enable the GitHub App integration locally.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
