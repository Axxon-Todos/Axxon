{
  "name": "axxon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n NEXT,WS -c \"blue.bold,green.bold\" \"pnpm dev-next\" \"pnpm dev-ws\"",
    "dev-next": "next dev",
    "dev-ws": "pnpm exec tsx watch src/lib/server.ts",
    "db:bootstrap": "pnpm exec tsx src/lib/db/utils/bootstrapDevDb.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:ci": "eslint src eslint.config.mjs vitest.backend.config.ts vitest.frontend.config.ts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:backend && pnpm test:frontend",
    "test:backend": "pnpm exec tsx src/test/backend/preflight.ts && vitest run --config vitest.backend.config.ts",
    "test:frontend": "vitest run --config vitest.frontend.config.ts",
    "migrate:make": "KNEX_MIGRATION_EXTENSION=ts pnpm exec tsx ./node_modules/knex/bin/cli.js migrate:make --knexfile knexfile.ts",
    "migrate:latest": "pnpm exec tsx ./node_modules/knex/bin/cli.js migrate:latest --knexfile knexfile.ts",
    "seed": "pnpm exec tsx ./node_modules/knex/bin/cli.js seed:run --knexfile ./knexfile.ts --env development",
    "rollback": "pnpm exec tsx ./node_modules/knex/bin/cli.js migrate:rollback --knexfile ./knexfile.ts --env development",
    "docker:dev": "docker compose --env-file .env.local up -d",
    "docker:dev:down": "docker compose --env-file .env.local down",
    "docker:dev:reset-db": "sh ./scripts/reset-dev-db.sh",
    "docker:prod": "docker compose --env-file .env.local -f docker-compose.prod.yml up --build -d",
    "docker:prod:down": "docker compose --env-file .env.local -f docker-compose.prod.yml down",
    "redis:start": "docker compose up -d redis",
    "redis:stop": "docker compose down",
    "redis:logs": "docker compose logs -f redis",
    "redis:cli": "docker compose exec redis redis-cli"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "@sentry/nextjs": "^9.29.0",
    "@tanstack/query-async-storage-persister": "^5.83.0",
    "@tanstack/query-sync-storage-persister": "^5.83.0",
    "@tanstack/react-query": "^5.83.0",
    "@tanstack/react-query-persist-client": "^5.83.0",
    "@tanstack/react-router": "^1.121.2",
    "axios": "^1.9.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "framer-motion": "^12.23.12",
    "ioredis": "^5.7.0",
    "jose": "^6.0.12",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.539.0",
    "next": "15.1.11",
    "next-auth": "^4.24.11",
    "pg": "^8.16.0",
    "pg-query-stream": "^4.10.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-window": "^1.8.11",
    "recharts": "^3.7.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "sqlite3": "^5.1.7",
    "three": "^0.179.1",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.179.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "dotenv": "^16.5.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "jsdom": "^26.1.0",
    "knex": "^3.1.0",
    "postcss": "^8.5.5",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.2",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
